{
  "name": "@wuemv/inertia-livewire",
  "version": "0.1.0",
  "description": "Mount server-rendered Livewire components inside any front-end framework: the shared core of the Inertia adapters.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuemv/inertia-livewire.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wuemv/inertia-livewire#readme",
  "bugs": "https://github.com/wuemv/inertia-livewire/issues",
  "keywords": ["livewire", "inertia", "laravel"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json"
  }
}
