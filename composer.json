{
    "name": "wuemv/inertia-livewire",
    "description": "Mount Livewire components inside Inertia pages: server-rendered by Laravel, started in place by Livewire, with Vue and React adapters.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "inertia",
        "vue",
        "react"
    ],
    "homepage": "https://github.com/wuemv/inertia-livewire",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/wuemv/inertia-livewire/issues",
        "source": "https://github.com/wuemv/inertia-livewire"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "livewire/livewire": "^3.6 || ^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Wuemv\\InertiaLivewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wuemv\\InertiaLivewire\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wuemv\\InertiaLivewire\\InertiaLivewireServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
