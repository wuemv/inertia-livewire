{
    "name": "wuemv/inertia-livewire",
    "description": "Mount Livewire components inside Inertia pages: server-rendered by Laravel, started in place by Livewire, with a Vue adapter.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "inertia",
        "vue",
        "react"
    ],
    "homepage": "https://github.com/wuemv/inertia-livewire",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/wuemv/inertia-livewire/issues",
        "source": "https://github.com/wuemv/inertia-livewire"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.61.1 || ^13.12.0",
        "illuminate/routing": "^12.61.1 || ^13.12.0",
        "illuminate/support": "^12.61.1 || ^13.12.0",
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "livewire/livewire": "^3.6 || ^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "shipfastlabs/pun": "^0.4.4"
    },
    "autoload": {
        "psr-4": {
            "Wuemv\\InertiaLivewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wuemv\\InertiaLivewire\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wuemv\\InertiaLivewire\\InertiaLivewireServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": [
            "pun format --test",
            "pun lint"
        ],
        "format": "pun format",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
